const APP = Object.freeze({
  NAME:'Ariful Assistant', VERSION:'4.3.0',
  SPREADSHEET_ID:'1iMYHbQzrgefg4McidDEJFH7n0Hlqm19Z1BHz3XtiGa4',
  DEFAULT_LANGUAGE:'bn', DEFAULT_LIMIT:10, MAX_LIMIT:50, MAX_QUERY_LENGTH:500,
  CACHE_SECONDS:120, ENABLE_WRITE_API:true,
  SHEETS:{KNOWLEDGE:'Knowledge',FAQ:'FAQ',CATEGORIES:'Categories',SETTINGS:'Settings',USERS:'Users',AUDIT:'AuditLogs'},
  SCHEMAS:{
    Knowledge:['Knowledge_ID','Title','Category','Keywords','Question','Answer','Content','Source','Language','Status','Updated_At'],
    FAQ:['FAQ_ID','Question','Answer','Keywords','Category','Language','Status','Updated_At'],
    Categories:['Category_ID','Category_Name','Description','Language','Status','Updated_At'],
    Settings:['Setting_Key','Setting_Value','Description','Updated_At'],
    Users:['User_ID','Email','Role','Status','Created_At'],
    AuditLogs:['Timestamp','Actor','Action','Status','Details','Request_ID']
  }
});
const ADMIN_CONFIG=Object.freeze({SESSION_TTL_SECONDS:1800,MAX_LOGIN_ATTEMPTS:5,LOGIN_LOCK_SECONDS:900,HASH_ITERATIONS:5000,SESSION_PREFIX:'AA_ADMIN_SESSION_',LOGIN_PREFIX:'AA_ADMIN_LOGIN_'});

function db_(){return SpreadsheetApp.openById(APP.SPREADSHEET_ID);}
function setupDatabase_(){ensureSchema_();initializeSettings_();audit_('SYSTEM','DATABASE_SETUP','SUCCESS','Database initialized');return {success:true,message:'Database setup completed',version:APP.VERSION};}
function ensureSchema_(){const ss=db_();Object.keys(APP.SCHEMAS).forEach(n=>{const h=APP.SCHEMAS[n];let sh=ss.getSheetByName(n);if(!sh)sh=ss.insertSheet(n);if(!sh.getLastRow()||!sh.getLastColumn()){sh.getRange(1,1,1,h.length).setValues([h]);sh.setFrozenRows(1);sh.getRange(1,1,1,h.length).setFontWeight('bold');return;}const old=sh.getRange(1,1,1,sh.getLastColumn()).getDisplayValues()[0];const missing=h.filter(x=>old.indexOf(x)<0);if(missing.length)sh.getRange(1,sh.getLastColumn()+1,1,missing.length).setValues([missing]);sh.setFrozenRows(1);});}
function initializeSettings_(){const sh=db_().getSheetByName(APP.SHEETS.SETTINGS),keys=readRows_(sh).map(r=>String(r.Setting_Key||''));[['APP_NAME',APP.NAME,'Application name'],['APP_VERSION',APP.VERSION,'Application version'],['DEFAULT_LANGUAGE',APP.DEFAULT_LANGUAGE,'Default language'],['PUBLIC_SEARCH_ENABLED','TRUE','Enable public search']].forEach(x=>{if(!keys.includes(x[0]))appendObject_(sh,{Setting_Key:x[0],Setting_Value:x[1],Description:x[2],Updated_At:new Date()});});}
function doGet(e){if(e&&e.parameter&&String(e.parameter.page||'')==='admin')return HtmlService.createHtmlOutputFromFile('Index').setTitle(APP.NAME+' — Admin Dashboard');return json_({success:true,app:APP.NAME,version:APP.VERSION,status:'running',endpoints:['health','search','faq','categories','get_by_id','add_knowledge','update_knowledge','add_faq']});}
function doPost(e){const rid=newId_('REQ');try{const b=parseBody_(e),a=text_(b.action,60).toLowerCase();if(!a)throw Error('Missing action');if(a==='health')return json_({success:true,app:APP.NAME,version:APP.VERSION,status:'running',request_id:rid});let d;switch(a){case'login_admin':d=loginAdmin(b.username,b.password);break;case'logout_admin':d=logoutAdmin(b.session_token);break;case'search':case'faq':case'categories':case'get_by_id':authorizeApiKey_(b.api_key);if(a==='search')d=search_(b);else if(a==='faq')d=searchFaq_(b);else if(a==='categories')d=listCategories_(b);else d=getById_(b);break;case'add_knowledge':requireAdminSession_(b.session_token);d=addKnowledge_(b);break;case'update_knowledge':requireAdminSession_(b.session_token);d=updateKnowledge_(b);break;case'add_faq':requireAdminSession_(b.session_token);d=addFaq_(b);break;default:throw Error('Unsupported action');}return json_({success:true,request_id:rid,data:d});}catch(err){audit_('API','REQUEST','FAILED',String(err.message||err),rid);return json_({success:false,error:safeError_(err),request_id:rid});}}
function authorizeApiKey_(k){const x=PropertiesService.getScriptProperties().getProperty('ARIFUL_ASSISTANT_API_KEY');if(!x)throw Error('API key is not configured');if(!constantEqual_(String(k||''),x))throw Error('Unauthorized API request');}
function requireAdminApi_(k){if(!APP.ENABLE_WRITE_API)throw Error('Write API is disabled');const x=PropertiesService.getScriptProperties().getProperty('ARIFUL_ASSISTANT_ADMIN_KEY');if(!x)throw Error('Admin API key is not configured');if(!constantEqual_(String(k||''),x))throw Error('Admin API authorization failed');}
function constantEqual_(a,b){a=String(a||'');b=String(b||'');if(a.length!==b.length)return false;let n=0;for(let i=0;i<a.length;i++)n|=a.charCodeAt(i)^b.charCodeAt(i);return n===0;}
function search_(b){const q=text_(b.query||b.q,APP.MAX_QUERY_LENGTH);if(!q)throw Error('Search query is required');const lang=text_(b.language||APP.DEFAULT_LANGUAGE,10),cat=text_(b.category,120),lim=limit_(b.limit),off=offset_(b.offset),cache=CacheService.getScriptCache(),gen=cache.get('search_generation')||'initial',key='search_'+Utilities.base64EncodeWebSafe(JSON.stringify({q:norm_(q),lang,cat,lim,off,gen})).substring(0,180),hit=cache.get(key);if(hit)return JSON.parse(hit);const rows=readRows_(db_().getSheetByName(APP.SHEETS.KNOWLEDGE)),out=[];rows.forEach(r=>{if(!active_(r.Status)||!languageMatch_(r.Language,lang)||(cat&&norm_(r.Category)!==norm_(cat)))return;const score=keywordScore_(q,[r.Title,r.Category,r.Keywords,r.Question,r.Answer,r.Content].join(' '));if(score>0)out.push(Object.assign({},r,{Score:score}));});out.sort((a,b)=>b.Score-a.Score);const result={query:q,total:out.length,limit:lim,offset:off,results:out.slice(off,off+lim),search_type:'keyword'};try{cache.put(key,JSON.stringify(result),APP.CACHE_SECONDS);}catch(e){}return result;}
function keywordScore_(q,c){q=norm_(q);const t=norm_(c);if(!q||!t)return 0;if(q===t)return 100;if(t.includes(q))return 80;const qt=tokens_(q),tt=tokens_(t);let m=0;qt.forEach(x=>{if(tt.includes(x))m++;else if(t.includes(x))m+=.5;});return qt.length?Math.round(m/qt.length*60):0;}
function searchFaq_(b){const q=text_(b.query||b.q,APP.MAX_QUERY_LENGTH),lang=text_(b.language||APP.DEFAULT_LANGUAGE,10),lim=limit_(b.limit),off=offset_(b.offset),out=[];readRows_(db_().getSheetByName(APP.SHEETS.FAQ)).forEach(r=>{if(!active_(r.Status)||!languageMatch_(r.Language,lang))return;const score=q?keywordScore_(q,[r.Question,r.Answer,r.Keywords,r.Category].join(' ')):1;if(score>0)out.push(Object.assign({},r,{Score:score}));});out.sort((a,b)=>b.Score-a.Score);return {query:q,total:out.length,limit:lim,offset:off,results:out.slice(off,off+lim)};}
function listCategories_(b){const lang=text_((b||{}).language||APP.DEFAULT_LANGUAGE,10),results=readRows_(db_().getSheetByName(APP.SHEETS.CATEGORIES)).filter(r=>active_(r.Status)&&languageMatch_(r.Language,lang));return {total:results.length,results};}
function getById_(b){const id=text_(b.id||b.record_id,100);if(!id)throw Error('Record ID is required');const c=adminTableConfig_(b.type||'Knowledge'),r=readRows_(db_().getSheetByName(c.sheet)).find(x=>String(x[c.idField]||'')===id);if(!r)throw Error('Record not found');return r;}
function addKnowledge_(b){const title=text_(b.Title||b.title,250);if(!title)throw Error('Knowledge title is required');const r={Knowledge_ID:newId_('KNW'),Title:title,Category:text_(b.Category||b.category,120),Keywords:text_(b.Keywords||b.keywords,1000),Question:text_(b.Question||b.question,2000),Answer:text_(b.Answer||b.answer,10000),Content:text_(b.Content||b.content,20000),Source:text_(b.Source||b.source,1000),Language:text_(b.Language||b.language||APP.DEFAULT_LANGUAGE,10),Status:text_(b.Status||b.status||'Active',30),Updated_At:new Date()};appendObject_(db_().getSheetByName(APP.SHEETS.KNOWLEDGE),r);clearSearchCache_();return r;}
function updateKnowledge_(b){const id=text_(b.Knowledge_ID||b.id,100);if(!id)throw Error('Knowledge_ID is required');const sh=db_().getSheetByName(APP.SHEETS.KNOWLEDGE),h=getHeaders_(sh),rows=readRows_(sh),i=rows.findIndex(r=>String(r.Knowledge_ID)===id);if(i<0)throw Error('Knowledge record not found');const r=Object.assign({},rows[i]);h.forEach(k=>{if(b[k]!==undefined&&k!=='Knowledge_ID')r[k]=text_(b[k],20000);});r.Updated_At=new Date();h.forEach((k,j)=>sh.getRange(i+2,j+1).setValue(safeCell_(r[k])));clearSearchCache_();return r;}
function addFaq_(b){const q=text_(b.Question||b.question,2000);if(!q)throw Error('FAQ question is required');const r={FAQ_ID:newId_('FAQ'),Question:q,Answer:text_(b.Answer||b.answer,10000),Keywords:text_(b.Keywords||b.keywords,1000),Category:text_(b.Category||b.category,120),Language:text_(b.Language||b.language||APP.DEFAULT_LANGUAGE,10),Status:text_(b.Status||b.status||'Active',30),Updated_At:new Date()};appendObject_(db_().getSheetByName(APP.SHEETS.FAQ),r);return r;}

// Admin credentials/session management. Password hash is salted; use a long unique password.
/**
 * Run this PUBLIC wrapper manually from the Apps Script editor.
 * It blocks calls from a different active user, then invokes the private initializer.
 */
function initializeAdminCredentials(){
  const activeEmail = String(Session.getActiveUser().getEmail() || '').toLowerCase();
  const ownerEmail = String(Session.getEffectiveUser().getEmail() || '').toLowerCase();
  if (!activeEmail || !ownerEmail || activeEmail !== ownerEmail) {
    throw new Error('For security, run initializeAdminCredentials() directly from the Apps Script editor while signed in as the script owner.');
  }
  return initializeAdminCredentials_();
}

function initializeAdminCredentials_(){const p=PropertiesService.getScriptProperties(),u=p.getProperty('ADMIN_INITIAL_USERNAME'),pw=p.getProperty('ADMIN_INITIAL_PASSWORD');if(!u||!pw)throw Error('Set ADMIN_INITIAL_USERNAME and ADMIN_INITIAL_PASSWORD in Script Properties first');if(pw.length<12)throw Error('Admin password must be at least 12 characters');const salt=Utilities.getUuid()+Utilities.getUuid();p.setProperties({ADMIN_USERNAME:u,ADMIN_PASSWORD_SALT:salt,ADMIN_PASSWORD_HASH:hashPassword_(pw,salt)},true);p.deleteProperty('ADMIN_INITIAL_USERNAME');p.deleteProperty('ADMIN_INITIAL_PASSWORD');return {success:true,message:'Admin credentials initialized'};}
function hashPassword_(pw,salt){let v=salt+'|'+pw;for(let i=0;i<ADMIN_CONFIG.HASH_ITERATIONS;i++)v=Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,v));return v;}
function loginAdmin(username,password){const p=PropertiesService.getScriptProperties(),u=p.getProperty('ADMIN_USERNAME'),salt=p.getProperty('ADMIN_PASSWORD_SALT'),hash=p.getProperty('ADMIN_PASSWORD_HASH');if(!u||!salt||!hash)throw Error('Admin credentials are not configured. Run initializeAdminCredentials_() from the editor.');const cache=CacheService.getScriptCache(),key=ADMIN_CONFIG.LOGIN_PREFIX+Utilities.base64EncodeWebSafe(String(username||'').toLowerCase()),attempt=Number(cache.get(key)||0);if(attempt>=ADMIN_CONFIG.MAX_LOGIN_ATTEMPTS)throw Error('Too many login attempts. Try again in 15 minutes.');if(!constantEqual_(String(username||''),u)||!constantEqual_(hashPassword_(String(password||''),salt),hash)){cache.put(key,String(attempt+1),ADMIN_CONFIG.LOGIN_LOCK_SECONDS);audit_('ADMIN','LOGIN','FAILED','Invalid credentials');throw Error('Invalid username or password');}cache.remove(key);const token=Utilities.getUuid()+Utilities.getUuid()+Utilities.getUuid(),session={username:u,createdAt:Date.now(),expiresAt:Date.now()+ADMIN_CONFIG.SESSION_TTL_SECONDS*1000};cache.put(ADMIN_CONFIG.SESSION_PREFIX+token,JSON.stringify(session),ADMIN_CONFIG.SESSION_TTL_SECONDS);audit_(u,'LOGIN','SUCCESS','Admin login');return {success:true,token,username:u,expiresIn:ADMIN_CONFIG.SESSION_TTL_SECONDS};}
function requireAdminSession_(token){token=String(token||'');if(!/^[a-f0-9-]{80,120}$/i.test(token))throw Error('Invalid or expired admin session. Please log in through the Admin Dashboard.');const c=CacheService.getScriptCache(),raw=c.get(ADMIN_CONFIG.SESSION_PREFIX+token);if(!raw)throw Error('Session expired or missing. Please log in through the Admin Dashboard again.');const s=JSON.parse(raw);if(Date.now()>Number(s.expiresAt||0)){c.remove(ADMIN_CONFIG.SESSION_PREFIX+token);throw Error('Session expired. Please log in again.');}return s;}
function logoutAdmin(token){token=String(token||'');if(/^[a-f0-9-]{80,120}$/i.test(token))CacheService.getScriptCache().remove(ADMIN_CONFIG.SESSION_PREFIX+token);return {success:true};}
function getAdminDashboard(token){const s=requireAdminSession_(token),ss=db_(),k=readRows_(ss.getSheetByName(APP.SHEETS.KNOWLEDGE)),f=readRows_(ss.getSheetByName(APP.SHEETS.FAQ)),c=readRows_(ss.getSheetByName(APP.SHEETS.CATEGORIES)),logs=readRows_(ss.getSheetByName(APP.SHEETS.AUDIT));return {success:true,username:s.username,knowledgeCount:k.length,faqCount:f.length,categoryCount:c.length,activeKnowledge:k.filter(r=>active_(r.Status)).length,activeFaq:f.filter(r=>active_(r.Status)).length,recentLogs:logs.slice(-10).reverse()};}
function getAdminKnowledge(token,o){requireAdminSession_(token);o=o||{};let r=readRows_(db_().getSheetByName(APP.SHEETS.KNOWLEDGE));const q=norm_(o.query||''),st=norm_(o.status||''),cat=norm_(o.category||'');if(q)r=r.filter(x=>norm_([x.Title,x.Category,x.Keywords,x.Question,x.Answer,x.Content].join(' ')).includes(q));if(st)r=r.filter(x=>norm_(x.Status)===st);if(cat)r=r.filter(x=>norm_(x.Category)===cat);r.reverse();const lim=limit_(o.limit),off=offset_(o.offset);return {success:true,total:r.length,limit:lim,offset:off,results:r.slice(off,off+lim)};}
function getAdminRecord(token,type,id){requireAdminSession_(token);const c=adminTableConfig_(type),r=readRows_(db_().getSheetByName(c.sheet)).find(x=>String(x[c.idField]||'')===String(id||''));if(!r)throw Error('Record not found');return {success:true,record:r};}
function getAdminFaq(token,o){requireAdminSession_(token);o=o||{};let r=readRows_(db_().getSheetByName(APP.SHEETS.FAQ));const q=norm_(o.query||''),st=norm_(o.status||'');if(q)r=r.filter(x=>norm_([x.Question,x.Answer,x.Keywords,x.Category].join(' ')).includes(q));if(st)r=r.filter(x=>norm_(x.Status)===st);r.reverse();const lim=limit_(o.limit),off=offset_(o.offset);return {success:true,total:r.length,limit:lim,offset:off,results:r.slice(off,off+lim)};}
function getAdminCategories(token){requireAdminSession_(token);const r=readRows_(db_().getSheetByName(APP.SHEETS.CATEGORIES));return {success:true,total:r.length,results:r.reverse()};}
function normalizeAdminType_(type){const t=String(type||'Knowledge').toLowerCase().trim();if(t==='knowledge')return 'Knowledge';if(t==='faq')return 'FAQ';if(t==='category'||t==='categories')return 'Categories';throw Error('Unsupported record type');}
function adminTableConfig_(type){const t=normalizeAdminType_(type);if(t==='Knowledge')return {sheet:APP.SHEETS.KNOWLEDGE,idField:'Knowledge_ID',prefix:'KNW'};if(t==='FAQ')return {sheet:APP.SHEETS.FAQ,idField:'FAQ_ID',prefix:'FAQ'};return {sheet:APP.SHEETS.CATEGORIES,idField:'Category_ID',prefix:'CAT'};}
function saveAdminRecord(token,type,record,id){const s=requireAdminSession_(token);if(!record||typeof record!=='object')throw Error('Invalid record data');const c=adminTableConfig_(type),sh=db_().getSheetByName(c.sheet),h=getHeaders_(sh),rows=readRows_(sh),f=c.idField,rid=String(id||record[f]||'').trim();let row=-1,saved={};if(rid){const i=rows.findIndex(x=>String(x[f]||'')===rid);if(i<0)throw Error('Record not found');row=i+2;saved=Object.assign({},rows[i]);}else saved[f]=newId_(c.prefix);h.forEach(k=>{if(Object.prototype.hasOwnProperty.call(record,k)&&k!==f&&k!=='Updated_At')saved[k]=text_(record[k],20000);});saved[f]=saved[f]||newId_(c.prefix);saved.Status=saved.Status||'Active';saved.Language=saved.Language||APP.DEFAULT_LANGUAGE;saved.Updated_At=new Date();if(row<0)appendObject_(sh,saved);else h.forEach((k,j)=>sh.getRange(row,j+1).setValue(safeCell_(saved[k])));clearSearchCache_();audit_(s.username,(rid?'UPDATE_':'CREATE_')+normalizeAdminType_(type).toUpperCase(),'SUCCESS',saved[f]);return {success:true,action:rid?'updated':'created',record:saved};}
function archiveAdminRecord(token,type,id){const s=requireAdminSession_(token),c=adminTableConfig_(type),sh=db_().getSheetByName(c.sheet),h=getHeaders_(sh),r=readRows_(sh),i=r.findIndex(x=>String(x[c.idField]||'')===String(id||''));if(i<0)throw Error('Record not found');const j=h.indexOf('Status');if(j<0)throw Error('Status column missing');sh.getRange(i+2,j+1).setValue('Archived');const u=h.indexOf('Updated_At');if(u>=0)sh.getRange(i+2,u+1).setValue(new Date());clearSearchCache_();audit_(s.username,'ARCHIVE_'+normalizeAdminType_(type).toUpperCase(),'SUCCESS',String(id));return {success:true,message:'Record archived'};}
function getAdminLogs(token){requireAdminSession_(token);const r=readRows_(db_().getSheetByName(APP.SHEETS.AUDIT));return {success:true,total:r.length,results:r.reverse().slice(0,200)};}
function getAdminSystemStatus(token){requireAdminSession_(token);const ss=db_();return {success:true,app:APP.NAME,version:APP.VERSION,status:'running',spreadsheetConnected:true,timestamp:new Date().toISOString(),sheets:Object.keys(APP.SHEETS).map(k=>{const n=APP.SHEETS[k],s=ss.getSheetByName(n);return {name:n,exists:!!s,rows:s?Math.max(0,s.getLastRow()-1):0,columns:s?s.getLastColumn():0};})};}
function createDatabaseBackup_(){const ss=db_(),stamp=Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyy-MM-dd_HH-mm-ss'),f=DriveApp.getFileById(ss.getId()).makeCopy(APP.NAME+'_Backup_'+stamp);audit_('SYSTEM','DATABASE_BACKUP','SUCCESS',f.getId());return {success:true,backupId:f.getId(),backupName:f.getName()};}
function healthCheck_(){const ss=db_();return {success:true,app:APP.NAME,version:APP.VERSION,spreadsheet:ss.getName(),timestamp:new Date().toISOString()};}
function readRows_(sh){if(!sh||sh.getLastRow()<2||sh.getLastColumn()<1)return [];const v=sh.getRange(1,1,sh.getLastRow(),sh.getLastColumn()).getValues(),h=v[0].map(x=>String(x||'').trim());return v.slice(1).map(row=>{const o={};h.forEach((k,i)=>{if(k)o[k]=row[i];});return o;});}
function getHeaders_(sh){return !sh||!sh.getLastColumn()?[]:sh.getRange(1,1,1,sh.getLastColumn()).getDisplayValues()[0].map(x=>String(x||'').trim());}
function appendObject_(sh,o){const h=getHeaders_(sh);if(!h.length)throw Error('Sheet headers are missing');sh.appendRow(h.map(k=>safeCell_(o[k])));return sh.getLastRow();}
function active_(s){return ['active','true','published','1'].includes(norm_(s));}
function languageMatch_(a,b){const x=norm_(a),y=norm_(b);return !x||!y||x===y||x==='all';}
function norm_(v){return String(v==null?'':v).toLowerCase().trim().replace(/\s+/g,' ');}
function tokens_(v){return norm_(v).split(/[\s,.;:!?()[\]{}"'\x60/\\|]+/).filter(Boolean);}
function text_(v,max){let s=String(v==null?'':v).trim();if(max&&s.length>max)s=s.substring(0,max);return s;}
function safeCell_(v){if(v===null||v===undefined)return '';if(v instanceof Date||typeof v==='number'||typeof v==='boolean')return v;const s=String(v);return /^[=+\-@]/.test(s)?"'"+s:s;}
function limit_(v){const n=parseInt(v,10);return !Number.isFinite(n)||n<1?APP.DEFAULT_LIMIT:Math.min(n,APP.MAX_LIMIT);}
function offset_(v){const n=parseInt(v,10);return !Number.isFinite(n)||n<0?0:Math.min(n,1000000);}
function newId_(p){return String(p||'ID')+'-'+Date.now().toString(36).toUpperCase()+'-'+Utilities.getUuid().replace(/-/g,'').substring(0,8).toUpperCase();}
function clearSearchCache_(){CacheService.getScriptCache().put('search_generation',newId_('GEN'),21600);}
function parseBody_(e){if(!e||!e.postData||!e.postData.contents)return {};try{return JSON.parse(e.postData.contents);}catch(err){throw Error('Request body must be valid JSON');}}
function safeError_(err){const m=String(err&&err.message?err.message:err);return /permission|authorization|unauthorized|admin|api key|session|not found|required|unsupported|invalid|disabled|configured|expired|too many/i.test(m)?m:'Request could not be completed. Check server logs.';}
function json_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);}
function audit_(actor,action,status,details,rid){try{const ss=db_();let sh=ss.getSheetByName(APP.SHEETS.AUDIT);if(!sh){sh=ss.insertSheet(APP.SHEETS.AUDIT);sh.getRange(1,1,1,APP.SCHEMAS.AuditLogs.length).setValues([APP.SCHEMAS.AuditLogs]);}appendObject_(sh,{Timestamp:new Date(),Actor:text_(actor,200),Action:text_(action,100),Status:text_(status,50),Details:text_(details,2000),Request_ID:text_(rid||newId_('REQ'),100)});}catch(err){console.error('Audit logging failed',err);}}
